{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug all tests (unittest discover)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "tests",
        "-p",
        "test_*.py",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Debug test_frontend_text_normalize",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["tests.test_frontend_text_normalize", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: Debug unittest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["${relativeFile}", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
